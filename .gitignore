# Secrets — never commit
.env

# Python environment
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs (generated at runtime by launchd)
*.log
*.log.out
*.log.err
automation.log

# Runtime state
# jobs-seen.json is intentionally NOT ignored: the Job Scraper routine (cloud, no
# local disk between runs) commits it after each run for cross-session dedup memory.
irrigation-history.json
# ^ Smart Irrigation used to maintain this the same way, but no longer does: it
# derives sensor-stall/trend history straight from Ecowitt's own device/history
# API each run instead, since Ecowitt already retains it server-side — no push
# dependency needed. This file is now just a local artifact from before that
# change; it's ignored again and no longer read or written by the script.

# Surf Compare's --data-only -> --render cache (avoids re-hitting Stormglass's
# 10/day free-tier quota between the two steps of one routine run)
.surf_cache_am.json
.surf_cache_pm.json

# Generated previews
ledger_preview.html

# Personal files
resume-summary.txt

# Debug screenshots
*.png

# Claude Code
.claude/
