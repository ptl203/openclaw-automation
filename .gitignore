# Secrets — never commit
.env

# Python environment
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs (generated at runtime by launchd)
*.log
*.log.out
*.log.err
automation.log

# Runtime state
# jobs-seen.json and irrigation-history.json are intentionally NOT ignored: both
# routines run cloud-side with no local disk between invocations, so each commits
# its state file back to the repo after every run to persist across sessions.

# Surf Compare's --data-only -> --render cache (avoids re-hitting Stormglass's
# 10/day free-tier quota between the two steps of one routine run)
.surf_cache_am.json
.surf_cache_pm.json

# Generated previews
ledger_preview.html

# Personal files
resume-summary.txt

# Debug screenshots
*.png

# Claude Code
.claude/
